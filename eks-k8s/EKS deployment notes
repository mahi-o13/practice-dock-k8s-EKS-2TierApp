echo "Installing AWS CLI v2"

apt update -y
apt install -y unzip curl

curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
-o "awscliv2.zip"

unzip -o awscliv2.zip

./aws/install --update

echo "Verification"

aws --version
eksctl version

